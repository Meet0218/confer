# --- POSTGRES ---
# Example local postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/confer

# --- REDIS ---
REDIS_URL=redis://localhost:6379

# --- NODE SERVER ---
PORT=3001
JWT_SECRET=super_secret_jwt_key_change_in_prod

# --- TWILIO (Video) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_API_KEY=SK...
TWILIO_API_SECRET=...

# --- STRIPE (Payments) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- AI SERVICE ---
# The URL where the python AI service is running
AI_SERVICE_URL=http://localhost:8000
# Only one of these is needed depending on the provider used
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...

# --- CLIENT ---
# The URL where the vite client will run (for CORS)
CLIENT_URL=http://localhost:5173
