{
  "name": "confer-root",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\" \"npm run dev:ai\"",
    "dev:ai": "cd ai-service && python -m uvicorn main:app --reload --port 8000",
    "install:all": "npm install && cd ai-service && pip install -r requirements.txt",
    "migrate": "npm run migrate -w server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^8.2.2",
    "prettier": "^3.9.6",
    "vite": "^8.2.1"
  }
}
